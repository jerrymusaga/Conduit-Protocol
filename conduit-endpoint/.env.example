# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4500

# ---------------------------------------------------------------------------
# Chain — must match the facilitator's chain.
# 84532 = Base Sepolia (dev), 8453 = Base mainnet (final demo)
# ---------------------------------------------------------------------------
CHAIN_ID=84532

# ---------------------------------------------------------------------------
# Conduit facilitator this endpoint sends buyers to. The endpoint reads the
# facilitator's /supported at startup to learn the redeemer + enforcer.
# ---------------------------------------------------------------------------
FACILITATOR_URL=http://localhost:4400

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
# Where the USDC payment lands (the seller's address). Any address you control.
PAY_TO=0x

# Price for the protected resource, as a human decimal of USDC.
# "0.01" = 1 cent. Converted to base units (6 decimals) internally.
PRICE_USDC=0.01

# Optional human description shown in the 402 envelope.
RESOURCE_DESCRIPTION=Conduit protected demo resource
