{
  "name": "conduit-facilitator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open x402 facilitator implementing the erc7710 asset transfer method. Settles via a pluggable relay backend (viem-direct on testnet, 1Shot Permissionless Relayer on mainnet).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "safe-stable-stringify": "^2.5.0",
    "tsx": "^4.19.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
