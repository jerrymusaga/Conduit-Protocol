# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4400

# ---------------------------------------------------------------------------
# Chain — 84532 = Base Sepolia (dev), 8453 = Base mainnet (final demo)
# ---------------------------------------------------------------------------
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# X402ReceiptEnforcer deployed address for the selected chain.
# Base Sepolia: 0x111115259a41bd174c7C1f6B7eE36ec1Ab3CD5c1
# Base mainnet: (deploy + fill in before the mainnet demo)
X402_RECEIPT_ENFORCER=0x111115259a41bd174c7C1f6B7eE36ec1Ab3CD5c1

# ---------------------------------------------------------------------------
# 1Shot Permissionless Relayer — Conduit settles through it (gas in stablecoin).
# URL must match CHAIN_ID:
#   testnet (Sepolia / Base Sepolia 84532): https://relayer.1shotapi.dev/relayers
#   mainnet (Base 8453):                     https://relayer.1shotapi.com/relayers
# Optional — if unset, derived from CHAIN_ID automatically.
# ---------------------------------------------------------------------------
ONESHOT_RELAYER_URL=https://relayer.1shotapi.dev/relayers
# Stablecoin the relayer charges gas in (USDC | USDT | USDG | mUSD).
ONESHOT_GAS_TOKEN=USDC

# Optional — public URL of this facilitator's inbound 1Shot webhook
# (POST /relayer-webhook). Needs a public tunnel in dev (e.g. ngrok). If unset,
# the backend polls relayer_getStatus.
# ONESHOT_WEBHOOK_URL=https://your-tunnel.example/relayer-webhook

# Optional — forward clean settlement events to an integrator's URL.
# WEBHOOK_URL=https://your-endpoint.example/webhook
