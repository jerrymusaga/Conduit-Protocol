# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4400

# ---------------------------------------------------------------------------
# Chain — 84532 = Base Sepolia (dev), 8453 = Base mainnet (final demo)
# ---------------------------------------------------------------------------
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# X402ReceiptEnforcer deployed address for the selected chain.
# Base Sepolia: 0x111115259a41bd174c7C1f6B7eE36ec1Ab3CD5c1
# Base mainnet: (deploy + fill in before the mainnet demo)
X402_RECEIPT_ENFORCER=0x111115259a41bd174c7C1f6B7eE36ec1Ab3CD5c1

# ---------------------------------------------------------------------------
# Relay backend — "viem-direct" (testnet dev) | "oneshot-pl" (mainnet demo)
# ---------------------------------------------------------------------------
RELAY_BACKEND=viem-direct

# --- viem-direct backend only ---
# A funded EOA that submits redeemDelegations on testnet. Throwaway key.
# Needs a little Base Sepolia ETH for gas.
RELAYER_PRIVATE_KEY=0x

# --- oneshot-pl backend only ---
# 1Shot Permissionless Relayer JSON-RPC endpoint (mainnet).
ONESHOT_RELAYER_URL=https://relayer.1shotapi.com/relayers
# Stablecoin the relayer charges gas in (USDC | USDT | USDG | mUSD).
ONESHOT_GAS_TOKEN=USDC

# ---------------------------------------------------------------------------
# Optional — where settle status callbacks are POSTed. If unset, callers
# poll GET /jobs/:id instead.
# ---------------------------------------------------------------------------
# WEBHOOK_URL=https://your-endpoint.example/webhook
