# Chain — 84532 = Base Sepolia (dev), 8453 = Base mainnet (final demo)
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org

# Conduit facilitator (the service the dapp drives)
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:4400

# Protected resource server (the demo seller)
NEXT_PUBLIC_ENDPOINT_URL=http://localhost:4500

# On-chain addresses (Base Sepolia). Mainnet: fill in before the mainnet demo.
NEXT_PUBLIC_X402_RECEIPT_ENFORCER=0x111115259a41bd174c7C1f6B7eE36ec1Ab3CD5c1

# Privy — the embedded-wallet + auth provider. Required. Create an app at
# https://dashboard.privy.io and paste the App ID here. Enable Email, GitHub,
# and Wallet (external) under Login Methods; add Base Sepolia + Base under
# Networks. Client ID is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# All NEXT_PUBLIC_* vars are exposed to the browser. Never put private keys here.
